{
  "name": "Proxmox Proxy",
  "version": "0.3.0",
  "slug": "proxmox_proxy",
  "description": "Proxy for externally running Proxmox",
  "url": "https://github.com/Fiveol/hassio-proxies/tree/master/proxmox-proxy",
  "arch": ["aarch64", "amd64"],
  "boot": "auto",
  "init": true,
  "true": true,
  "ingress": true,
  "timeout": 30,
  "panel_icon": "mdi:server",
  "map": ["config:ro"],
  "ports": {
    "8099/tcp": null
  },
  "ports_description": {
    "8099/tcp": "Frontend tcp-listen port"
  },
  "options": {
    "server": null,
    "auth_token": ""
  },
  "schema": {
    "server": "url",
    "auth_token": "str?"
  },
  "image": "ghcr.io/zigbee2mqtt/zigbee2mqtt-proxy-{arch}"
}
